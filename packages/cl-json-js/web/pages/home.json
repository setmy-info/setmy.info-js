["cl:progn",
  ["cl:defvar", "user", ["cl:quote", {"name": "Ann", "score": 150}]],
  ["cl:defvar", "orders", ["cl:quote", [{"title": "Book", "price": 12}, {"title": "Pen", "price": 2.5}]]],

  [":div", [":class", "pwa-card", ":id", "user-widget"],
    [":h3", ["cl:format", null, "Welcome back, ~a", ["cl:getf", "user.name"]]],
    ["cl:if", ["cl:>", ["cl:getf", "user.score"], 100],
      [":div", {"class": "badge-vip", "style": "color: #a16207; font-weight: bold"}, "VIP Member"],
      [":div", {"class": "badge-standard"}, "Standard Account"]],
    [":h4", "Your Orders:"],
    [":ul", [":class", "order-list"],
      ["cl:dolist", ["order", ["cl:getf", "orders"]],
        [":li", [":class", "order-item"],
          [":span", [":class", "title"], ["cl:getf", "order.title"]],
          " ",
          [":span", [":class", "price"],
            ["cl:format", null, "$~,2f", ["cl:getf", "order.price"]]]]]],
    [":p",
      [":button", {"on-click": ["cl:lambda", [], ["cl:incf", "user.score", 50]]}, "Score + 50"], " ",
      [":button", {"on-click": ["cl:lambda", [], ["cl:decf", "user.score", 50]]}, "Score - 50"], " ",
      ["cl:format", null, "score ~d", ["cl:getf", "user.score"]]]]]
