["cl:progn",
  ["cl:defvar", "draft", ""],
  ["cl:defvar", "filter", ":all"],
  ["cl:defvar", "todos", ["cl:quote", [[":text", "Read prompt.md", ":done", true],
                                       [":text", "Write a JSON-CL payload", ":done", false],
                                       [":text", "Ship it", ":done", false]]]],

  ["cl:defun", "todo:add", [],
    ["cl:let", [["text", ["cl:string-trim", " ", ["cl:getf", "draft"]]]],
      ["cl:when", ["cl:plusp", ["cl:length", ["cl:getf", "text"]]],
        ["cl:setf",
          "todos", ["cl:append", ["cl:getf", "todos"],
                     ["cl:list", ["cl:list", ":text", ["cl:getf", "text"], ":done", false]]],
          "draft", ""]]]],

  ["cl:defun", "todo:done-p", ["todo"],
    ["cl:getf", ["cl:getf", "todo"], ":done"]],

  ["cl:defun", "todo:visible-p", ["todo"],
    ["cl:case", ["cl:getf", "filter"],
      [":active", ["cl:not", ["todo:done-p", ["cl:getf", "todo"]]]],
      [":done", ["todo:done-p", ["cl:getf", "todo"]]],
      ["cl:otherwise", true]]],

  [":div",
    [":p",
      [":input", {"id": "todo-draft", "type": "text", "placeholder": "What needs doing?",
                  "value": ["cl:getf", "draft"],
                  "on-input": ["cl:lambda", ["e"],
                                ["cl:setf", "draft", ["cl:getf", "e.target.value"]]],
                  "on-keydown": ["cl:lambda", ["e"],
                                  ["cl:when", ["cl:string=", ["cl:getf", "e.key"], "Enter"],
                                    ["todo:add"]]]}],
      " ",
      [":button", {"on-click": ["cl:lambda", [], ["todo:add"]]}, "Add"]],

    [":ul", {"class": "todos"},
      ["cl:dolist", ["todo", ["cl:remove-if-not", ["cl:function", "todo:visible-p"],
                               ["cl:getf", "todos"]]],
        [":li", {"class": ["cl:when", ["todo:done-p", ["cl:getf", "todo"]], "done"],
                 "style": ["cl:when", ["todo:done-p", ["cl:getf", "todo"]],
                            "color: #6b7280; text-decoration: line-through"]},
          [":label",
            [":input", {"type": "checkbox",
                        "checked": ["todo:done-p", ["cl:getf", "todo"]],
                        "on-change": ["cl:lambda", [],
                                       ["cl:setf", ["cl:getf", ["cl:getf", "todo"], ":done"],
                                                   ["cl:not", ["todo:done-p", ["cl:getf", "todo"]]]]]}],
            " ",
            ["cl:getf", ["cl:getf", "todo"], ":text"]]]]],

    [":p", {"class": "footer"},
      ["cl:format", null, "~d item~:p left",
        ["cl:length", ["cl:remove-if", ["cl:function", "todo:done-p"], ["cl:getf", "todos"]]]],
      " · ",
      ["cl:dolist", ["f", ["cl:quote", [":all", ":active", ":done"]]],
        [":button", {"class": ["cl:when", ["cl:string=", ["cl:getf", "f"], ["cl:getf", "filter"]],
                               "selected"],
                     "style": ["cl:when", ["cl:string=", ["cl:getf", "f"], ["cl:getf", "filter"]],
                                "font-weight: bold"],
                     "on-click": ["cl:lambda", [], ["cl:setf", "filter", ["cl:getf", "f"]]]},
          ["cl:string-capitalize", ["cl:getf", "f"]]]],
      " · ",
      [":button", {"on-click": ["cl:lambda", [],
                     ["cl:setf", "todos", ["cl:remove-if", ["cl:function", "todo:done-p"],
                                            ["cl:getf", "todos"]]]]},
        "Clear done"]]]]
