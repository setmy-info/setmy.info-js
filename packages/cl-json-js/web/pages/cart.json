["cl:progn",
  ["cl:defvar", "freeShippingFrom", 40],
  ["cl:defvar", "shippingCost", 4.9],
  ["cl:defvar", "items", ["cl:quote", [{"name": "Coffee beans", "price": 12.5, "qty": 1},
                                       {"name": "Mug", "price": 8, "qty": 2},
                                       {"name": "Filter papers", "price": 3.2, "qty": 0}]]],

  ["cl:defun", "shop:line-total", ["item"],
    ["cl:*", ["cl:getf", "item.price"], ["cl:getf", "item.qty"]]],

  ["cl:let*",
    [["subtotal", ["cl:reduce", ["cl:function", "cl:+"],
                    ["cl:mapcar", ["cl:function", "shop:line-total"], ["cl:getf", "items"]],
                    0]],
     ["free", ["cl:>=", ["cl:getf", "subtotal"], ["cl:getf", "freeShippingFrom"]]],
     ["shipping", ["cl:if", ["cl:getf", "free"], 0, ["cl:getf", "shippingCost"]]]],

    [":div",
      [":table",
        [":tr", [":th", "Item"], [":th", "Price"], [":th", "Qty"], [":th", "Total"]],
        ["cl:dolist", ["item", ["cl:getf", "items"]],
          [":tr", {"class": ["cl:when", ["cl:zerop", ["cl:getf", "item.qty"]], "muted"],
                   "style": ["cl:when", ["cl:zerop", ["cl:getf", "item.qty"]],
                              "color: #6b7280; text-decoration: line-through"]},
            [":td", ["cl:getf", "item.name"]],
            [":td", ["cl:format", null, "~,2f €", ["cl:getf", "item.price"]]],
            [":td",
              [":button", {"on-click": ["cl:lambda", [],
                             ["cl:when", ["cl:plusp", ["cl:getf", "item.qty"]],
                               ["cl:decf", "item.qty"]]]}, "-"],
              " ", ["cl:getf", "item.qty"], " ",
              [":button", {"on-click": ["cl:lambda", [], ["cl:incf", "item.qty"]]}, "+"]],
            [":td", ["cl:format", null, "~,2f €", ["shop:line-total", ["cl:getf", "item"]]]]]]],

      [":p", {"class": "summary"},
        ["cl:format", null, "Subtotal ~,2f € · Shipping ", ["cl:getf", "subtotal"]],
        ["cl:if", ["cl:getf", "free"],
          [":strong", "free"],
          ["cl:format", null, "~,2f €", ["cl:getf", "shipping"]]],
        " · ",
        [":strong", ["cl:format", null, "Total ~,2f €",
                      ["cl:+", ["cl:getf", "subtotal"], ["cl:getf", "shipping"]]]]],

      ["cl:unless", ["cl:getf", "free"],
        [":p", {"class": "hint"},
          ["cl:format", null, "Add ~,2f € more for free shipping.",
            ["cl:-", ["cl:getf", "freeShippingFrom"], ["cl:getf", "subtotal"]]]]]]]]
