["cl:progn",
  ["cl:defvar", "target", 15],
  ["cl:defvar", "sales", ["cl:quote", [["Jan", 12], ["Feb", 19], ["Mar", 7],
                                       ["Apr", 23], ["May", 15], ["Jun", 28]]]],

  ["cl:let*",
    [["top", ["cl:apply", ["cl:function", "cl:max"],
               ["cl:mapcar", ["cl:function", "cl:second"], ["cl:getf", "sales"]]]],
     ["bar", 60],
     ["height", 160],
     ["width", ["cl:*", ["cl:getf", "bar"], ["cl:length", ["cl:getf", "sales"]]]],
     ["target-y", ["cl:-", ["cl:getf", "height"],
                    ["cl:round", ["cl:*", ["cl:getf", "height"],
                                   ["cl:/", ["cl:getf", "target"], ["cl:getf", "top"]]]]]]],

    [":div",
      [":p", "Target: ", [":strong", ["cl:getf", "target"]], " ",
        [":button", {"on-click": ["cl:lambda", [], ["cl:decf", "target", 5]]}, "- 5"], " ",
        [":button", {"on-click": ["cl:lambda", [], ["cl:incf", "target", 5]]}, "+ 5"], " ",
        ["cl:format", null, "(~d of ~d months on target)",
          ["cl:length", ["cl:remove-if-not",
                          ["cl:lambda", ["row"], ["cl:>=", ["cl:second", ["cl:getf", "row"]],
                                                           ["cl:getf", "target"]]],
                          ["cl:getf", "sales"]]],
          ["cl:length", ["cl:getf", "sales"]]]],

      [":svg", {"width": 480,
                "viewBox": ["cl:format", null, "0 -14 ~d ~d",
                             ["cl:getf", "width"], ["cl:+", ["cl:getf", "height"], 34]],
                "font-size": 11},
        ["cl:dotimes", ["i", ["cl:length", ["cl:getf", "sales"]]],
          ["cl:let*",
            [["row", ["cl:nth", ["cl:getf", "i"], ["cl:getf", "sales"]]],
             ["value", ["cl:second", ["cl:getf", "row"]]],
             ["h", ["cl:round", ["cl:*", ["cl:getf", "height"],
                                  ["cl:/", ["cl:getf", "value"], ["cl:getf", "top"]]]]],
             ["x", ["cl:*", ["cl:getf", "i"], ["cl:getf", "bar"]]]],
            [":g",
              [":rect", {"x": ["cl:+", ["cl:getf", "x"], 10],
                         "y": ["cl:-", ["cl:getf", "height"], ["cl:getf", "h"]],
                         "width": ["cl:-", ["cl:getf", "bar"], 20],
                         "height": ["cl:getf", "h"],
                         "fill": ["cl:if", ["cl:>=", ["cl:getf", "value"], ["cl:getf", "target"]],
                                   "#16a34a", "#dc2626"]}],
              [":text", {"x": ["cl:+", ["cl:getf", "x"], ["cl:/", ["cl:getf", "bar"], 2]],
                         "y": ["cl:-", ["cl:-", ["cl:getf", "height"], ["cl:getf", "h"]], 4],
                         "text-anchor": "middle"},
                ["cl:getf", "value"]],
              [":text", {"x": ["cl:+", ["cl:getf", "x"], ["cl:/", ["cl:getf", "bar"], 2]],
                         "y": ["cl:+", ["cl:getf", "height"], 16],
                         "text-anchor": "middle"},
                ["cl:first", ["cl:getf", "row"]]]]]],
        [":line", {"x1": 0, "x2": ["cl:getf", "width"],
                   "y1": ["cl:getf", "target-y"], "y2": ["cl:getf", "target-y"],
                   "stroke": "#2563eb", "stroke-dasharray": "5 4"}]]]]]
