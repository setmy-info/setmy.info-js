["cl:progn",
  ["cl:defvar", "n", 30],

  ["cl:defun", "fizz:cell", ["text", "kind", "color"],
    [":span", {"class": ["cell", ["cl:getf", "kind"]],
               "style": ["cl:format", null,
                          "display: inline-block; width: 5em; margin: 2px; text-align: center; background: ~a",
                          ["cl:getf", "color"]]},
      ["cl:getf", "text"]]],

  [":div",
    [":p", "Numbers 1 to ", [":strong", ["cl:getf", "n"]], " ",
      [":button", {"on-click": ["cl:lambda", [],
                     ["cl:when", ["cl:>", ["cl:getf", "n"], 15],
                       ["cl:decf", "n", 15]]]}, "- 15"],
      " ",
      [":button", {"on-click": ["cl:lambda", [], ["cl:incf", "n", 15]]}, "+ 15"]],
    [":div",
      ["cl:dotimes", ["i", ["cl:getf", "n"]],
        ["cl:let", [["k", ["cl:1+", ["cl:getf", "i"]]]],
          ["cl:cond",
            [["cl:zerop", ["cl:mod", ["cl:getf", "k"], 15]], ["fizz:cell", "FizzBuzz", "fizzbuzz", "#bbf7d0"]],
            [["cl:zerop", ["cl:mod", ["cl:getf", "k"], 3]], ["fizz:cell", "Fizz", "fizz", "#dbeafe"]],
            [["cl:zerop", ["cl:mod", ["cl:getf", "k"], 5]], ["fizz:cell", "Buzz", "buzz", "#fef3c7"]],
            [true, ["fizz:cell", ["cl:getf", "k"], null, "#f3f4f6"]]]]]]]]
