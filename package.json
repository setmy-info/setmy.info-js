{
    "name": "node-monorepo-demo",
    "version": "1.0.0",
    "description": "Monorepo Demo",
    "license": "MIT",
    "private": true,
    "packageManager": "npm@10.9.2",
    "keywords": [
        "Keyword"
    ],
    "author": "Imre Tabur <imre.tabur@mail.ee>",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "clean": "npm run clean --workspaces --if-present",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "validate": "npm run format:check && npm run lint && npm run typecheck",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "integration-test": "npm run integration-test --workspaces --if-present",
        "e2e-test": "npm run e2e-test --workspaces --if-present",
        "coverage": "npm run coverage --workspaces --if-present",
        "audit": "npm audit --audit-level=high",
        "docs": "npm run docs --workspaces --if-present",
        "release": "npm publish --workspaces"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "esbuild": "^0.28.1",
        "eslint": "^10.7.0",
        "eslint-plugin-security": "^4.0.1",
        "globals": "^16.4.0",
        "http-server": "^14.1.1",
        "jsdoc": "^4.0.5",
        "prettier": "^3.9.5",
        "rimraf": "^6.0.1",
        "start-server-and-test": "^2.1.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0"
    }
}
