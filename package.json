{
    "name": "setmy.info-js",
    "version": "1.0.0",
    "description": "Monorepo for JavaScript and TypeScript modules, libraries, applications and API-s",
    "license": "MIT",
    "private": true,
    "author": "Imre Tabur <imre.tabur@mail.ee>",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "workspaces": [
        "packages/commons",
        "packages/a",
        "packages/b",
        "packages/c",
        "packages/d"
    ],
    "scripts": {
        "clean": "node scripts/clean.js",
        "format": "node scripts/format.js",
        "format:check": "node scripts/format.js --check",
        "lint": "eslint .",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "build": "npm run build --workspaces --if-present",
        "pre-integration-test": "node scripts/lifecycle.js pre-integration-test",
        "post-integration-test": "node scripts/lifecycle.js post-integration-test",
        "pre-e2e-test": "node scripts/lifecycle.js pre-e2e-test",
        "post-e2e-test": "node scripts/lifecycle.js post-e2e-test",
        "test": "node scripts/test.js unit",
        "integration-test": "node scripts/test.js integration",
        "e2e-test": "node scripts/test.js e2e",
        "coverage": "node scripts/test.js coverage",
        "audit": "npm audit --audit-level=high",
        "reports": "node scripts/reports.js",
        "docs": "jsdoc --recurse --destination reports/docs packages/commons/src packages/a/src packages/c/src packages/d/src",
        "package": "node -e \"fs.mkdirSync('dist', { recursive: true })\" && npm pack --workspaces --pack-destination dist",
        "deploy": "node scripts/deploy.js",
        "release": "node scripts/release.js"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "esbuild": "^0.28.1",
        "eslint": "^10.7.0",
        "eslint-plugin-security": "^4.0.1",
        "globals": "^16.4.0",
        "jsdoc": "^4.0.5",
        "prettier": "^3.9.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0"
    }
}
